# Plantilla de variables de entorno. Copia este archivo como `.env` y rellena los valores reales.
# El archivo `.env` está ignorado por git (no subas tus credenciales).

# Base de datos PostgreSQL
DB_USER=
DB_PASSWORD=

# JWT
# JWT_SECRET: clave secreta para firmar los tokens (mínimo 32 caracteres / 256 bits para HS256)
JWT_SECRET=
# JWT_EXPIRATION: tiempo de expiración del token en milisegundos (ej. 3600000 = 1 hora)
JWT_EXPIRATION=3600000

# Google OAuth2 (Google Cloud Console -> Credenciales -> ID de cliente OAuth 2.0)
GOOGLE_ID=
GOOGLE_SECRET=
